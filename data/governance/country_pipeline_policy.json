{
  "policy_id": "country_pipeline_policy",
  "version": "1.0.0",
  "derived_from": [
    "COUNTRY_REVIEW_EXECUTION_PROTOCOL.md",
    "CRES.md",
    "scripts/rules_schema.py"
  ],
  "notes": "Executable governance for the Governed Country Pipeline. Human protocol docs remain normative narrative; this file is what validators enforce.",

  "drafting": {
    "allowed_claim_statuses": ["verified", "bounded"],
    "forbidden_claim_statuses": ["verification_target", "superseded", "source_intake_pending"],
    "forbid_unmapped_fields": true,
    "forbid_unmapped_sentences": false,
    "required_binding_fields": [
      "country_overview",
      "summary.traveler",
      "summary.business",
      "rules.bring_foreign_currency_in",
      "rules.take_foreign_currency_out",
      "rules.cash_declaration_threshold",
      "rules.resident_holding_rules",
      "rules.non_resident_rules",
      "rules.business_invoicing_settlement",
      "rules.exchange_controls",
      "rules.banking_conversion_practicality"
    ]
  },

  "publication": {
    "require_indexing_allowed": true,
    "require_page_status": ["verified", "published"],
    "require_no_blocking_findings": true,
    "require_evidence_tier": ["official_verified"],
    "auto_flip_disabled": true
  },

  "sources": {
    "require_official_primary_for": [
      "legal_thresholds",
      "mandatory_actions",
      "prohibited_actions"
    ],
    "primary_source_types": [
      "central_bank",
      "customs",
      "ministry",
      "regulator",
      "primary_regulator",
      "primary_regulator_faq",
      "primary_regulator_rule_page",
      "fiu"
    ],
    "forbid_superseded_urls_in_draft": true
  },

  "review": {
    "layers": ["structural", "evidence", "fidelity", "governance"],
    "max_auto_correct_cycles": 1,
    "human_review_triggers": [
      "source_conflict",
      "multi_interpretation_legal_claim"
    ]
  },

  "auto_correct": {
    "allowed_actions": [
      "remove_forbidden_status_bindings",
      "replace_superseded_source_urls",
      "tighten_soft_modals_from_claim_wording",
      "remove_forbidden_inference_phrases"
    ],
    "disallowed_actions": [
      "invent_evidence",
      "upgrade_claim_status",
      "flip_publication_lifecycle"
    ]
  },

  "claim_categories_requiring_primary": [
    "legal_thresholds",
    "mandatory_actions",
    "prohibited_actions"
  ],

  "intake": {
    "required_authored_artifacts": ["sources.json", "evidence_excerpts.json"],
    "generated_artifacts": ["intake_report.json"],
    "fail_on_intake_report_drift": true,
    "official_primary_only": true,
    "excerpt_requires_current_source": true,
    "allow_superseded_excerpt_with_human_review": true,
    "superseded_excerpt_never_downstream_eligible": true,
    "ambiguous_never_downstream_eligible": true,
    "bounded_paraphrase_never_downstream_eligible_by_default": true,
    "require_pinpoint": true,
    "require_representation_enum": true,
    "require_content_persistence_declaration": true,
    "require_capture_status": true,
    "claim_neutrality_status_required": true,
    "neutrality_heuristics_are_partial": true,
    "offline_validator_does_not_prove_textual_fidelity": true,
    "stale_source_warn_days": 180,
    "official_authority_kinds": [
      "central_bank",
      "customs",
      "ministry",
      "legislature_publication",
      "regulator",
      "fiu",
      "primary_regulator",
      "primary_regulator_faq",
      "primary_regulator_rule_page"
    ],
    "forbidden_operator_voice_patterns": [
      "page_status",
      "indexing_allowed",
      "evidence_tier",
      "verification_target",
      "downstream_eligible",
      "claim_id",
      "field_bindings"
    ],
    "milestone_scope_forbidden_path_globs": [
      "data/rules/**",
      "data/coverage/pipeline/*/claims.json",
      "data/coverage/pipeline/*/field_bindings.json"
    ],
    "milestone_scope_allowed_path_globs": [
      "data/governance/country_pipeline_policy.json",
      "scripts/pipeline_schema.py",
      "scripts/validate_source_intake.py",
      "scripts/validate_pipeline_milestone_scope.py",
      "scripts/country_pipeline.py",
      "scripts/validate_country_pipeline.py",
      ".github/workflows/governance-gate.yml",
      "COUNTRY_REVIEW_EXECUTION_PROTOCOL.md",
      "docs/PIPELINE_PHASE2_M1_PLAN.md",
      "data/coverage/pipeline/*/sources.json",
      "data/coverage/pipeline/*/evidence_excerpts.json",
      "data/coverage/pipeline/*/intake_report.json"
    ]
  }
}
